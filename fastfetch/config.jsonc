{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "/home/dautist/Customization/Fastfetch/cachyos.png",
    "width": 24,
    "height": 12,
    "chafa": {
      "fgOnly": true,
      "symbols": "block",
      "canvasMode": "INDEXED_16"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "key": {
      "width": 9
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "{3} {12}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "format": "{1}d {2}h {3}m"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{1} {2}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "format": "{3}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "temp": true,
      "format": "{numa-nodes}",
      "shorthand": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "temp": false,
      "shorthand": true
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{1} / {2}"
    },
    {
      "type": "swap",
      "key": "Swap",
      "format": "{1} / {2}"
    },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "localip",
      "key": "Local IP",
      "showPrefixLen": false,
      "showIpv6": false,
      "showMac": false,
      "showLoopback": false
    },
    {
      "type": "battery",
      "key": "Battery",
      "format": "{4} [{1}]"
    }
  ]
}
